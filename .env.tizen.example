# Copy to .env.tizen (gitignored) and fill in. Read by packages/tv-kit/scripts/tizen.mjs.

# Package ids are exactly 10 letters or digits; install fails with [118,-4] otherwise.
SECRETARY_TV_PACKAGE_ID=ScrtMovies
SECRETARY_TV_LAUNCHER_ID=ScrtLaunch
SECRETARY_TV_SERIES_ID=ScrtSeries
SECRETARY_TV_ANIME_ID=ScrtAnimes

# Samsung certificate profile name from Tizen Studio's Certificate Manager.
# The TV's DUID must be included in the distributor certificate. Empty means the active profile.
SECRETARY_TV_PROFILE=
# sdb serial of the TV, for example 192.168.1.50:26101. Empty means the only connected device.
SECRETARY_TV_SERIAL=
# Where the TV reaches packages/server: this computer's LAN address, not localhost.
# Hosted (docs/hosting.md): https://<host>/<SERVER_KEY>.
SECRETARY_TV_SERVER_URL=http://192.168.1.10:7000

# Metadata API keys (TMDB for movies/series primary meta, TVDB for multi-season anime grouping, FANART for Nest dashboard artwork).
TMDB_API_KEY=
TVDB_API_KEY=
FANART_API_KEY=
# Trakt API client id: reads Trakt lists in Nuvio collections (docs/nuvio-cloud.md, phase 8). Empty skips them.
TRAKT_CLIENT_ID=

# Nuvio plugin repositories the TV starts with, comma separated (docs/plugins.md). None ships with this project;
# Settings > Sources adds and removes them on the TV.
SECRETARY_TV_PLUGIN_REPOS=

# Accounts and sync (docs/nuvio-cloud.md). Empty NUVIO_URL/NUVIO_KEY use the public Nuvio Cloud;
# SYNC_BACKEND=secretary keeps your own server as the only backend (dev and tests).
NUVIO_URL=
NUVIO_KEY=
SYNC_BACKEND=
# SmartThings straight from Nest (docs/smartthings.md): the OAuth app from `smartthings.mjs create-app`. Without it,
# Nest uses SMARTTHINGS_TOKEN from .env (a personal token, about 24 h).
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
# Ask Nest on the TV (docs/launcher.md): a Gemini key gives voice, spoken replies and free questions without the
# server. It ships inside the .wgt, so restrict it to the Generative Language API. Empty keeps Gemini on the server.
NEST_GEMINI_API_KEY=
# Weather without the server: Nest uses the SmartThings location, else these (coordinates, or a city looked up once).
WEATHER_LAT=
WEATHER_LON=
WEATHER_CITY=
# Watch-party Worker origin (docs/watch-party.md). Empty hides "Watch together".
PARTY_URL=
