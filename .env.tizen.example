# Copy to .env.tizen (gitignored) and fill in. Read by packages/tv-kit/scripts/tizen.mjs.

# Secretary's package id: exactly 10 letters or digits; install fails with [118,-4] otherwise.
SECRETARY_TV_LAUNCHER_ID=ScrtLaunch

# Samsung certificate profile name from Tizen Studio's Certificate Manager.
# The TV's DUID must be included in the distributor certificate. Empty means the active profile.
SECRETARY_TV_PROFILE=
# sdb serial of the TV, for example 192.168.1.50:26101. Empty means the only connected device.
SECRETARY_TV_SERIAL=
# Where the TV reaches packages/server: this computer's LAN address, not localhost.
# Hosted (docs/hosting.md): https://<host>/<SERVER_KEY>.
SECRETARY_TV_SERVER_URL=http://192.168.1.10:7000

# Metadata API keys (TMDB for movies/series primary meta, TVDB for multi-season anime grouping, FANART for Secretary's artwork).
TMDB_API_KEY=
TVDB_API_KEY=
FANART_API_KEY=
# Trakt API client id: reads Trakt lists in Nuvio collections (docs/nuvio-cloud.md, phase 8). Empty skips them.
TRAKT_CLIENT_ID=
# Simkl app client id (simkl.com/settings/developer, redirect urn:ietf:wg:oauth:2.0:oob): the watch tracker in
# Settings › Accounts (docs/simkl.md). Empty shows Simkl as unavailable.
SIMKL_CLIENT_ID=
# OAuth 2.0 Simkl apps (the default for new apps) also need the secret for the device sign-in. It ships in the .wgt.
SIMKL_CLIENT_SECRET=
# AniList app client id (anilist.co/settings/developer, redirect https://anilist.co/api/v2/oauth/pin): the anime tracker
# in Settings › Accounts (docs/anilist.md). The token is pasted through Secretary Desk's phone keyboard. No secret needed.
ANILIST_CLIENT_ID=

# Nuvio plugin repositories the TV starts with, comma separated (docs/plugins.md). None ships with this project;
# Settings > Sources adds and removes them on the TV.
SECRETARY_TV_PLUGIN_REPOS=

# Accounts and sync (docs/nuvio-cloud.md). Empty NUVIO_URL/NUVIO_KEY use the public Nuvio Cloud;
# SYNC_BACKEND=secretary keeps your own server as the only backend (dev and tests).
NUVIO_URL=
NUVIO_KEY=
SYNC_BACKEND=
# SmartThings straight from Secretary (docs/smartthings.md): the OAuth app from `smartthings.mjs create-app`. Without it,
# Secretary uses SMARTTHINGS_TOKEN from .env (a personal token, about 24 h).
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
# Ask Secretary on the TV (docs/launcher.md): a Gemini key gives voice, spoken replies and free questions without the
# server. It ships inside the .wgt, so restrict it to the Generative Language API. Empty keeps Gemini on the server.
NEST_GEMINI_API_KEY=
# Optional: a Groq key turns the room microphone's clip into words (Whisper) faster than Gemini, which stays the fallback
# and still answers and speaks. Also ships inside the .wgt.
NEST_GROQ_API_KEY=
# The catalog and its player run inside Secretary (docs/embedding-catalog.md), so the catalog keys above and the debrid
# keys in .env travel in this build: never share a .wgt you built.
# Optional: the YouTube card shows what is popular with a YouTube Data API key (a key of your own); without it the card
# is a way into the YouTube app. NEST_YOUTUBE_APP_ID overrides the app id if the TV's differs (check with the app list).
NEST_YOUTUBE_API_KEY=
NEST_YOUTUBE_APP_ID=
# The side lights following the poster in focus (docs/smartthings.md), in milliseconds. A colour change is three moves,
# NEST_MOOD_STEP_MS apart (100-5000, default 500: about a second and a half); NEST_MOOD_SETTLE_MS is how long focus must
# rest on a poster before the lights start (0-10000, default 700), so browsing fast sends only the colour it stops on.
NEST_MOOD_STEP_MS=
NEST_MOOD_SETTLE_MS=
# Weather without the server: Secretary uses the SmartThings location, else these (coordinates, or a city looked up once).
WEATHER_LAT=
WEATHER_LON=
WEATHER_CITY=
# Watch-party Worker origin (docs/watch-party.md). Empty hides "Watch together".
PARTY_URL=
