# Your debrid keys (TorBox, Premiumize). The server currently resolves through TorBox only; a TV build also takes both as defaults for Settings > Sources
# (docs/plugins.md), so they end up inside your own .wgt: never share that package.
TORBOX_API_KEY=
PM_API_KEY=
# Where the TV reaches this server: this computer's LAN address (or a domain), not localhost.
BASE_URL=http://192.168.1.10:7000
PORT=7000
# Optional: base URL of a Stremio-style addon that answers /stream/<type>/<id>.json with info hashes. The TV uses it
# only when no plugin repository is set up, or when the plugins find nothing. Not included here.
UPSTREAM_ADDON=

# Optional: weather on Nest's home screen (Open-Meteo, no key). A city name, or coordinates.
# WEATHER_CITY=Berlin
# WEATHER_LAT=52.52
# WEATHER_LON=13.41

# Optional: the Secretary Bird assistant on Nest and Secretary Desk (Google Gemini). Empty uses built-in replies.
GEMINI_API_KEY=
# Optional: the Gemini speech model for spoken replies, tried before the built-in ones.
# GEMINI_TTS_MODEL=
# Optional: SmartThings (a personal access token, about 24 h since 2025). Nest uses it until the OAuth app is set up,
# and the setup script uses it to create that app (docs/smartthings.md).
SMARTTHINGS_TOKEN=

# Hosting on the internet (docs/hosting.md): every URL then starts with /<SERVER_KEY>. Leave empty at home.
# SERVER_KEY=
# BASE_URL=https://tv.example.com
# STATE_FILE=/data/secretary-state.json
